          like capture, back out, retry, back out. */}\n      <div className=\"flex gap-3\">\n        <button\n          type=\"button\"\n          onClick={onRetake}\n          disabled={saving}\n          aria-label=\"Retake\"\n          className=\"grid h-[54px] w-14 shrink-0 place-items-center rounded-[14px] bg-surface-2 text-muted-foreground shadow-[inset_0_0_0_1px_var(--hairline-6)] disabled:opacity-60\"\n        >\n          <RotateCcw size={19} />\n        </button>\n        <button\n          onClick={onSave}\n          disabled={saving}\n          className=\"flex-1 rounded-[12px] bg-foreground py-[17px] text-center font-semibold text-canvas disabled:opacity-60\"\n        >\n          {saving ? \"Saving…\" : \"Add to closet\"}\n        </button>\n      </div>\n    </div>\n  );\n}\n196:   * ⚠️ Deliberately absent from `taggingJsonSchema` below — the model cannot\n214:export type Tags = z.infer<typeof TagSchema>;\n241:export function forStructuredOutput(node: unknown): unknown {\n242:  if (Array.isArray(node)) return node.map(forStructuredOutput);\n247:      out[key] = forStructuredOutput(value);\n263:export const taggingJsonSchema = forStructuredOutput(\ncomponents/capture/capture-flow.tsx:31:          onTags={cap.updateTags}\ncomponents/capture/use-capture.ts:93:    setDraft((d) => (d ? { ...d, ...patch } : d));\ncomponents/capture/use-capture.ts:97:    setDraft((d) => (d ? { ...d, tags: { ...d.tags, ...patch } } : d));\ncomponents/capture/use-capture.ts:101:    setDraft((d) => {","is_error":false}]},"uuid":"c6fcea94-f4a4-4db5-9e73-318235d9db1d","timestamp":"2026-09-16T21:45:42.915Z","toolUseResult":{"stdout":"export function ConfirmForm({\n  draft,\n  saving,\n  error,\n  onDraft,\n  onTags,\n  onToggleSeason,\n  onSave,\n  onRetake,\n}: {\n  draft: Draft;\n  saving: boolean;\n  error: string | null;\n  onDraft: (patch: Partial<Draft>) => void;\n  onTags: (patch: Partial<Tags>) => void;\n  onToggleSeason: (s: Tags[\"seasons\"][number]) => void;\n  onSave: