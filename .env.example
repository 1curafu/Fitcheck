# Supabase (EU region project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose with NEXT_PUBLIC

# Account-deletion B2 ledger — server-only; restricted to deletion-ledger/ in the production backup bucket.
B2_DELETION_KEY_ID=
B2_DELETION_APPLICATION_KEY=
DELETION_LEDGER_HMAC_KEY=

# Anthropic — used server-side in tagging/reasoning Server Actions (plans 04 + 06)
ANTHROPIC_API_KEY=

# Google OAuth — read by supabase/config.toml via env() for local auth.
# Source this file before `supabase start`: set -a; source .env.local; set +a
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

SENTRY_AUTH_TOKEN=
OPENWEATHER_API_KEY=

# Billing (Stripe Managed Payments). Server-only secrets; set BOTH or billing stays off.
# Sandbox values for local/Preview, live values for Production. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public switch for the live Go Pro controls — baked in at build time; set together with the two above.
NEXT_PUBLIC_BILLING_ENABLED=
